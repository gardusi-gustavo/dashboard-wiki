{
  "schema": 1,
  "name": "wiki",
  "organization": "dashboards",
  "layer": 3,
  "depends_on": [
    "gardusi-gustavo/database-wiki"
  ],
  "consumers": [],
  "data_classification": "public",
  "visibility": "public",
  "template": {
    "ref": "0.3.2"
  },
  "publish": [],
  "hubs": {
    "practice": 1,
    "automation": 2
  },
  "ci": {
    "profile": "universal",
    "script": "infra/scripts/ci.sh"
  },
  "features": {
    "pages": true,
    "ci": true
  },
  "limits": {
    "repo_mb": 100,
    "file_mb": 25,
    "max_symlinks": 0
  },
  "readme": {
    "max_lines": 80
  },
  "files": {
    "infra_max_file_mb": 1,
    "rules": {
      "": {
        "allow_names": [
          "README.md",
          "AGENTS.md",
          ".gitignore",
          ".gitattributes",
          ".dockerignore",
          "VERSION",
          "CHANGELOG.md",
          "LICENSE",
          "SECURITY.md"
        ],
        "allow_globs": []
      },
      "docs/": {
        "allow_extensions": [
          ".md"
        ],
        "allow_names": [
          ".gitkeep"
        ]
      },
      "src/": {
        "allow_extensions": [
          ".json"
        ],
        "allow_names": [
          ".gitkeep"
        ]
      },
      "infra/config/": {
        "allow_extensions": [
          ".json"
        ]
      },
      "infra/scripts/": {
        "allow_extensions": [
          ".sh",
          ".py"
        ],
        "allow_names": [
          ".gitkeep"
        ]
      },
      "infra/docker/": {
        "allow_globs": [
          "*.dockerfile"
        ]
      },
      ".gitea/workflows/": {
        "allow_extensions": [
          ".yml",
          ".yaml"
        ]
      },
      ".gitea/issue_template/": {
        "allow_extensions": [
          ".md",
          ".yml",
          ".yaml"
        ]
      },
      ".gitea/": {
        "allow_names": [
          "pull_request_template.md"
        ]
      },
      ".gitea/scoped_workflows/": {
        "allow_extensions": [
          ".yml",
          ".yaml"
        ]
      },
      "docs/issues/": {
        "allow_extensions": [
          ".json",
          ".md"
        ],
        "allow_names": []
      },
      ".github/": {
        "allow_globs": [
          "*"
        ],
        "allow_names": [
          "CODEOWNERS"
        ]
      },
      ".github/workflows/": {
        "allow_extensions": [
          ".yml",
          ".yaml"
        ]
      },
      ".github/ISSUE_TEMPLATE/": {
        "allow_extensions": [
          ".yml",
          ".yaml",
          ".md"
        ]
      }
    },
    "forbid": [
      {
        "regex": "(^|/)[^/]*\\.md$",
        "reason": "Markdown is allowed only in docs/, README.md, and AGENTS.md",
        "allow": [
          "^README\\.md$",
          "^AGENTS\\.md$",
          "^docs/",
          "^\\.gitea/issue_template/",
          "^\\.gitea/pull_request_template\\.md$",
          "^CHANGELOG\\.md$",
          "^SECURITY\\.md$",
          "^\\.github/"
        ]
      },
      {
        "regex": "^infra/data/",
        "reason": "infra/data is retired; use src/data"
      },
      {
        "regex": "^infra/.*\\.(pdf|png|jpg|jpeg|gif|webp|mp4|mp3|zip|gz|tar|7z)$",
        "reason": "infra is repository management only"
      },
      {
        "regex": "^\\.gitlab-ci\\.yml$",
        "reason": "GitLab is not a source"
      }
    ]
  },
  "platforms": [
    "gitea",
    "github"
  ]
}
