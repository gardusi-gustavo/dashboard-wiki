{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wiki.local/schema/taxonomy.schema.json",
  "title": "Playlist taxonomy",
  "type": "object",
  "required": ["schema-version", "facets", "domains"],
  "additionalProperties": false,
  "properties": {
    "schema-version": { "const": 2 },
    "core-rule": { "type": "array", "items": { "type": "string" } },
    "facets": {
      "type": "object",
      "required": ["environment", "pursuit", "method", "tone"],
      "additionalProperties": {
        "type": "object",
        "required": ["question", "required"],
        "additionalProperties": false,
        "properties": {
          "question": { "type": "string" },
          "required": { "type": "boolean" }
        }
      }
    },
    "domains": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["definition", "facets", "core-candidate"],
        "additionalProperties": false,
        "properties": {
          "definition": { "type": "string", "minLength": 1 },
          "facets": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
          },
          "core-candidate": { "type": "boolean" }
        }
      }
    }
  }
}
